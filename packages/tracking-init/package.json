    "react-native",
    "location",
    "location-tracking",
    "background-location",
    "background-tracking",
    "gps",
    "gps-tracking",
    "geolocation",
    "expo-location",
    "expo-task-manager",
    "foreground-service",
    "offline",
    "async-storage",
    "location-permission",
    "tracking",
    "tracking-sdk",
    "mock-location",
    "android",
    "ios"
  ],
  "homepage": "https://github.com/Sonjoy209164/hajira#readme",
  "bugs": {
    "url": "https://github.com/Sonjoy209164/hajira/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sonjoy209164/hajira.git",
    "directory": "packages/tracking-init"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./trackingTask": {
      "types": "./dist/trackingTask.d.ts",
      "default": "./dist/trackingTask.js"
    }
  },
  "files": [
    "dist",
    "trackingTask.js",
    "trackingTask.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": "*",
    "@react-native-community/netinfo": "*",
    "expo-constants": "*",
    "expo-location": "*",
    "expo-task-manager": "*",
    "react": "*",
    "react-native": "*"
  },
  "dependencies": {
    "@hajiracm/tracking-core": "^0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
